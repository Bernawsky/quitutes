# Supabase (projeto "Automation") — URL e chave anônima são públicas por design.
NEXT_PUBLIC_SUPABASE_URL=https://mfvmhoimqvpsesobtwhl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tjUz4rlLda7zTCY5m70Zaw_HoUXbQRJ

# Service role key — NUNCA exponha no cliente. Usada pelos crons e pelas rotas de
# administração (convidar admin, alertas por e-mail) para ignorar RLS quando necessário.
# Pegue em Supabase > Project Settings > API > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o Vercel Cron para autorizar a chamada aos endpoints agendados.
CRON_SECRET=

# Resend (https://resend.com) — opcional. Sem isso, os alertas por e-mail (cancelamento,
# lembrete de pendências às 16h, relatório semanal) ficam desativados sem quebrar o app.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Anthropic (https://console.anthropic.com) — opcional. Usada para gerar a análise
# executiva do relatório de fechamento de período (feedback dos números para os
# fundadores). Sem isso, o e-mail sai sem a seção de análise, sem quebrar o fechamento.
ANTHROPIC_API_KEY=

# E-mails extras (separados por vírgula) que devem receber o relatório de fechamento
# de período além dos administradores cadastrados — ex: fundadores sem conta no sistema.
RELATORIO_EMAILS_EXTRA=
