# Supabase (projeto "Automation") — URL e chave anônima são públicas por design.
NEXT_PUBLIC_SUPABASE_URL=https://mfvmhoimqvpsesobtwhl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tjUz4rlLda7zTCY5m70Zaw_HoUXbQRJ

# Service role key — NUNCA exponha no cliente. Usada pelos crons e pelas rotas de
# administração (convidar admin, alertas por e-mail) para ignorar RLS quando necessário.
# Pegue em Supabase > Project Settings > API > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o Vercel Cron para autorizar a chamada aos endpoints agendados.
CRON_SECRET=

# Serviço de WhatsApp (open-wa, ver whatsapp-service/) — opcional. Sem isso, os alertas
# (cancelamento, lembrete de pendências às 16h, relatório semanal, fechamento de período)
# ficam desativados sem quebrar o app. Roda fora da Vercel (Railway, Fly.io, etc), ver
# whatsapp-service/README.md para deploy.
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_SECRET=

# Números de WhatsApp (separados por vírgula, formato 5532988887777) que devem
# receber os relatórios e alertas administrativos.
WHATSAPP_DESTINATARIOS=

# Anthropic (https://console.anthropic.com) — opcional. Usada para gerar a análise
# executiva do relatório de fechamento de período (feedback dos números para os
# fundadores). Sem isso, a mensagem sai sem a seção de análise, sem quebrar o fechamento.
ANTHROPIC_API_KEY=

# Notificações push do navegador (novo pedido, edição, cancelamento, voucher de buffet).
# Gere um par com `npx web-push generate-vapid-keys`. VAPID_PUBLIC_KEY e
# NEXT_PUBLIC_VAPID_PUBLIC_KEY devem ter o MESMO valor (a pública precisa estar
# disponível no navegador). Sem essas variáveis, o botão "Ativar notificações"
# fica indisponível, sem quebrar o app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:quitutesdabethibitipoca@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
